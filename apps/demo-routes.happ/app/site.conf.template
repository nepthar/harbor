# Three plain-text servers, one per route declared in manifest.toml.
# nginx:alpine's entrypoint runs envsubst over *.template files in
# /etc/nginx/templates, so ${HAPP_DOMAIN} (the primary FQDN harbor injects
# into every run unit) is filled in before nginx starts.

server {
    listen 8081;
    location / {
        default_type text/plain;
        return 200 'Hello from the server listening on the "main" route! This should be accessable by https://${HAPP_DOMAIN}\n';
    }
}

server {
    listen 8082;
    location / {
        default_type text/plain;
        return 200 'Hello from the secondary domain! This should be accessable at https://sub1-${HAPP_DOMAIN}\n';
    }
}

server {
    listen 8083;
    location / {
        default_type text/plain;
        return 200 'Hello from the route only accessable via lan\n';
    }
}
